(defmethod draw-option menu-generic-link-option ((this menu-generic-link-option) (progress progress) (font-ctx font-context) (index int) (selected? symbol))
  (let ((scroll-amt (-> *progress-scroll* transition)))
    ;; TODO
    ;; (cond
    ;;   ((or (and (progress-scrolling-up?) (= index *progress-scroll-start*))
    ;;         (and (progress-scrolling-down?) (= index (1- *progress-scroll-end*)))))
    ;;   ((or (and (progress-scrolling-down?) (= index (1- *progress-scroll-start*)))
    ;;         (and (progress-scrolling-up?) (= index *progress-scroll-end*)))
    ;;     (set! scroll-amt (- 1.0 scroll-amt)))
    ;;   (else (set! scroll-amt 1.0)))
    ;; TODO - handled disabled option and selected
    ;; (set-color! font-ctx
    ;;             (cond
    ;;               ((and (= index (-> progress option-index)) (not (or (progress-scrolling?) (-> progress in-transition))))
    ;;                 (font-color progress-selected))
    ;;               (else (font-color default))))
    (print-game-text (lookup-text! *common-text* (-> this name) #f) font-ctx #f (the int (* 128.0 (-> progress transition-percentage-invert) scroll-amt)) 22)
  )
  (none))


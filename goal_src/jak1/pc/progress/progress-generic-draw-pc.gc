(defmethod draw-option menu-generic-page ((this menu-generic-page) (progress progress) (_ font-context) (index int) (selected? symbol))
  ;; TODO - cleanup unused vars
  (let* ((line-amt (if (> (length (-> this menu-options)) PROGRESS_PC_PAGE_HEIGHT) (1- PROGRESS_PC_PAGE_HEIGHT) (length (-> this menu-options))))
         (y-off (- (-> this page-y-center) (/ (* (-> this page-y-space) line-amt) 2)))
         (x-off 17) ;; TODO - only changes for sliders, aka. option-x
         (unkx 27)
         (unk2 0)
         (font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
   ;; set the common params for the text drawing
   (set-width! font-ctx 370)
   (set-height! font-ctx 25)
   (set! (-> font-ctx flags) (font-flags shadow kerning middle middle-vert large))
   ;; set scroll arrow sprite vertical position right now
   (set! (-> progress particles 32 init-pos y) (the float (* 2 (- y-off 20))))
   ;; when scrolling we draw an extra line
   ;; TODO - break this stuff up
   (cond
     ((progress-scrolling-down?)
       (set! y-off (+ (- y-off (-> this page-y-space)) (* (the float (-> this page-y-space)) (- 1.0 (-> *progress-scroll* transition))))))
     ((progress-scrolling-up?) (set! y-off (+ (- y-off (-> this page-y-space)) (* (the float (-> this page-y-space)) (-> *progress-scroll* transition))))))
   (let ((draw-arrows (and (not (-> progress in-transition))
                           (= (-> progress next-state name) 'progress-normal)
                           (> (length (-> this menu-options)) PROGRESS_PC_PAGE_HEIGHT)
                           (< (mod (-> *display* real-frame-counter) (seconds 0.2)) (seconds 0.1))))
         (draw-prev (< 0 *progress-scroll-start*))
         (draw-next (> (length (-> this menu-options)) *progress-scroll-end*)))
     (set! (-> progress particles 32 init-pos x)
           (the float (if (and draw-arrows draw-prev) (- 195 (-> progress left-x-offset)) -320)))
     (set! (-> progress particles 33 init-pos x)
           (the float (if (and draw-arrows draw-next) (- 195 (-> progress left-x-offset)) -320))))
   ;; Iterate through page options and render them if we havn't hit the page limit yet
   (dotimes (index (length (-> this menu-options)))
     (when (or (<= (length (-> this menu-options)) PROGRESS_PC_PAGE_HEIGHT)
               (and (not (progress-scrolling?)) (>= index *progress-scroll-start*) (< index *progress-scroll-end*))
               (and (progress-scrolling-down?) (>= index (1- *progress-scroll-start*)) (< index *progress-scroll-end*))
               (and (progress-scrolling-up?) (>= index *progress-scroll-start*) (< index (1+ *progress-scroll-end*))))
       (let ((menu-option (-> this menu-options index)))
         ;; adjust scale
         (set-scale! font-ctx (* (-> this page-scale) (-> progress transition-percentage-invert) 1.0))
         ;; move to next position
         ;; TODO - preserve spacing just incase the drawing does something
         (set! (-> font-ctx origin x) (the float (- x-off (-> progress left-x-offset))))
         (set! (-> font-ctx origin y) (the float (the int (* (the float y-off) (if (-> menu-option scale) (-> progress transition-percentage-invert) 1.0)))))
         ;; render
         (draw-option menu-option progress font-ctx index #f)
         ;; move vertically
         (+! y-off (-> this page-y-space))
         )
         )))
  (none))

